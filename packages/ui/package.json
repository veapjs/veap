{
  "name": "@veap/ui",
  "version": "0.1.5",
  "description": "Veap UI Library",
  "author": "Damian Miller",
  "bugs": "https://github.com/veapjs/veap/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/veapjs/veap.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "import": "./dist/logo.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "import": "./dist/mdx.js"
    },
    "./globals.css": "./src/globals.css",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist",
    "src/globals.css"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "@iconify/react": "^6.0.2",
    "lucide-react": "^1.27.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.72.0",
    "swr": "^2.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
