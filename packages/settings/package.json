{
  "name": "@veap/settings",
  "version": "0.1.10",
  "description": "Application settings management, caching, and persistence for Veap",
  "author": "Damian Miller",
  "bugs": "https://github.com/veapjs/veap/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/veapjs/veap.git",
    "directory": "packages/settings"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@veap/database": "0.1.10",
    "@veap/kernel": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.1.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
