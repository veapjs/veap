{
  "name": "@veap/commentable",
  "private": true,
  "version": "0.1.0",
  "description": "Polymorphic threaded comment system for Veap ORM and UI",
  "author": "Damian Miller",
  "bugs": "https://github.com/veapjs/veap/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/veapjs/veap.git",
    "directory": "packages/veap-commentable"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@veap/database": "0.1.9"
  },
  "peerDependencies": {
    "@veap/auth": "^0.1.11",
    "@veap/ui": "^0.1.5",
    "lucide-react": "^1.27.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@veap/auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
