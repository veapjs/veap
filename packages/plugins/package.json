{
  "name": "@veap/plugins",
  "version": "0.1.13",
  "description": "Plugin lifecycle, extension points, and virtual router for Veap",
  "author": "Damian Miller",
  "bugs": "https://github.com/veapjs/veap/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/veapjs/veap.git",
    "directory": "packages/plugins"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@veap/auth": "0.1.12",
    "@veap/database": "0.1.10",
    "@veap/intl": "0.1.9",
    "@veap/kernel": "0.2.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@iconify/react": "^6.0.2",
    "@veap/ui": "^0.1.4",
    "lucide-react": "^1.55.0",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8"
  },
  "peerDependenciesMeta": {
    "@iconify/react": {
      "optional": true
    },
    "@veap/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@veap/ui": "^0.1.4",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "sonner": "^2.0.8",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
